# --- Used by the Next.js app at runtime ---
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Used to link/manage the Supabase CLI (not read by the app) ---
# Personal access token: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Project ref: the short id in supabase.com/dashboard/project/<ref>
SUPABASE_PROJECT_REF=
# The database password set when the project was created.
SUPABASE_DB_PASSWORD=

# --- Used by scripts/set-role.mjs (local dev only) ---
# Your own account's username and the role `pnpm role:set` switches it to.
TEST_USERNAME=
TEST_ROLE=

# A second real account (role: member) for testing the non-moderator view.
# Reference only, not read by any script.
TEST_MEMBER_EMAIL=
TEST_MEMBER_PASSWORD=
